# ── LLM: Gemini (PRIMARY) ──────────────────────────────────────────────────
GEMINI_API_KEY=          # required for chat — Gemini is the primary provider
GEMINI_MODEL=gemini-2.0-flash   # or gemini-1.5-flash, gemini-1.5-pro, etc.

# ── LLM: Groq (SECONDARY / fallback) ──────────────────────────────────────
GROQ_API_KEY=            # optional — used if Gemini call fails
GROQ_MODEL=llama-3.1-8b-instant

# ── TTS: Sarvam (Indian-language speech for Listen buttons) ───────────────
SARVAM_API_KEY=          # optional — if unset, Listen buttons are hidden
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh     # multilingual across all 11 Indian languages
# Language is chosen per request from the app's dropdown (en-IN, hi-IN, ...)
