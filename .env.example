# You have both keys — set them in Vercel → Settings → Environment Variables.
GROQ_API_KEY=            # chat assistant + context (required for chat)
SARVAM_API_KEY=          # Indian-language speech for the Listen buttons

# --- optional overrides (defaults already in code) ---
GROQ_MODEL=llama-3.1-8b-instant
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh     # bulbul:v3 default; multilingual across all 11 languages
# Language is chosen per request from the app's dropdown (en-IN, hi-IN, ta-IN, …)
