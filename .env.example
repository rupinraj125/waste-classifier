# ── LLM: Groq (PRIMARY — ~0.5s response, perfect JSON output) ────────────
GROQ_API_KEY=            # get from console.groq.com
GROQ_MODEL=qwen/qwen3.8-27b   # confirmed working; 131k ctx

# ── LLM: Gemini (SECONDARY fallback) ─────────────────────────────────────
GEMINI_API_KEY=          # get from aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash-lite   # confirmed working on this key type

# ── TTS: Sarvam (Indian-language voice for Listen buttons) ───────────────
SARVAM_API_KEY=          # optional — if unset, Listen buttons are hidden
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh     # multilingual across all 11 Indian languages
